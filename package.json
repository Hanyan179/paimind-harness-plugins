{
  "name": "hansen-harness-plugins",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check:packages": "node scripts/check-package-compliance.mjs",
    "check:packs": "node scripts/check-package-packs.mjs",
    "check:context-sources": "node scripts/check-context-provenance.mjs",
    "check:api": "node scripts/check-api-snapshot.mjs",
    "check:publint": "node scripts/check-publint.mjs",
    "check:bundles": "node scripts/check-bundle-budget.mjs",
    "check:nodenext": "node scripts/check-nodenext-consumer.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:fast": "pnpm run check:packages && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:bundles && pnpm run check:api && pnpm run check:packs && pnpm run check:publint && pnpm run check:nodenext && pnpm run check:examples && pnpm run verify:framework && pnpm run check:context-sources && pnpm run check:docs",
    "check:release": "pnpm run check:fast && node scripts/verify-harness-composition.mjs",
    "check": "pnpm run check:fast",
    "verify:framework": "node scripts/verify-framework.mjs",
    "verify:agent-skill-centers": "node scripts/verify-agent-skill-centers.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "migrate:scheduler-v2": "node scripts/migrate-scheduler-schema-v2.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "~18.3.27",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "30.0.1",
    "publint": "0.3.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
