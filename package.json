{
  "name": "paimind-harness-plugins",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check:packages": "node scripts/check-package-compliance.mjs",
    "check:packs": "node scripts/check-package-packs.mjs",
    "check:api": "node scripts/check-api-snapshot.mjs",
    "check:publint": "node scripts/check-publint.mjs",
    "check:nodenext": "node scripts/check-nodenext-consumer.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:fast": "pnpm run check:packages && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:api && pnpm run check:packs && pnpm run check:publint && pnpm run check:nodenext && pnpm run check:examples && pnpm run verify:framework && pnpm run check:docs",
    "check:release": "pnpm run check:fast && node scripts/verify-harness-composition.mjs",
    "check": "pnpm run check:fast",
    "verify:framework": "node scripts/verify-framework.mjs",
    "verify:agent-skill-centers": "node scripts/verify-agent-skill-centers.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "migrate:scheduler-v2": "node scripts/migrate-scheduler-schema-v2.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "~18.3.27",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "publint": "0.3.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
