{
  "name": "@hansen/scheduler-adapter-harness",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "description": "Harness Session and Native Job adapter for the Hansen platform scheduler",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./agent-action": { "types": "./lib/types/agent-action.d.ts", "default": "./lib/agent-action.js" },
    "./agent-tool": { "types": "./lib/types/agent-tool.d.ts", "default": "./lib/agent-tool.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js","lib/**/*.js.map","lib/**/*.d.ts","lib/**/*.d.ts.map"],
  "dependencies": {
    "@hansen/contracts": "workspace:^",
    "@hansen/harness-compat": "workspace:^",
    "@hansen/platform-scheduler": "workspace:^"
  },
  "devDependencies": { "@hansen/testkit": "workspace:^" },
  "hansenBuild": { "node": ["src/index.ts", "src/agent-action.ts", "src/agent-tool.ts", "src/invariant.ts"] },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
