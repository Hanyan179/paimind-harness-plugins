{
  "name": "@paimind/launcher",
  "version": "0.1.0-alpha.0",
  "description": "Retired PAIMind launcher source retained only as migration history",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "dependencies": {
    "@paimind/contracts": "workspace:^",
    "@paimind/harness-compat": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@paimind/testkit": "workspace:^",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
