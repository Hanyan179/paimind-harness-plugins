{
  "name": "@hansen/skill-market",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "description": "Hansen catalog and governance product layer over native Harness Session skills",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./catalog": { "types": "./lib/types/catalog.d.ts", "default": "./lib/catalog.js" },
    "./recommended": { "types": "./lib/types/recommended.d.ts", "default": "./lib/recommended.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/remote.js" },
    "./typert": { "types": "./lib/types/typert.d.ts", "default": "./lib/typert.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js","lib/**/*.js.map","lib/**/*.d.ts","lib/**/*.d.ts.map","SKILL.md","SKILL_AUTHORING.md"],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@hansen/contracts": "workspace:^",
    "@hansen/harness-compat": "workspace:^",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0",
    "yauzl": "^3.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": { "react": ">=18.0.0 <20.0.0" },
  "devDependencies": {
    "@hansen/testkit": "workspace:^",
    "@types/yauzl": "3.4.0",
    "@testing-library/react": "^16.3.2",
    "react": "^18.3.1"
  },
  "hansenBuild": {
    "node": ["src/index.ts", "src/catalog.ts", "src/recommended.ts", "src/invariant.ts", "src/remote.ts", "src/typert.ts"],
    "client": "src/client/index.tsx"
  },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
