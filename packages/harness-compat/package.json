{
  "name": "@hansen/harness-compat",
  "version": "0.1.0-alpha.0",
  "description": "Version-scoped compatibility boundary for DeepSeek Harness and Cordis APIs",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client-icons": {
      "types": "./lib/types/client-icons.d.ts",
      "default": "./lib/client-icons.js"
    },
    "./client-surface": {
      "types": "./lib/types/client-surface.d.ts",
      "default": "./lib/client-surface.js"
    },
    "./client-input-trigger": {
      "types": "./lib/types/client-input-trigger.d.ts",
      "default": "./lib/client-input-trigger.js"
    }
  },
  "files": ["lib/**/*.js","lib/**/*.js.map","lib/**/*.d.ts","lib/**/*.d.ts.map"],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-schedule": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@hansen/contracts": "workspace:^"
  },
  "hansenBuild": { "node": ["src/index.ts", "src/host.ts", "src/client-icons.ts", "src/client-surface.ts", "src/client-input-trigger.ts"] },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
