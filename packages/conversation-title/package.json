{
  "name": "@paimind/conversation-title",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "description": "Non-blocking PAIMind conversation title generation for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./settings": { "types": "./lib/types/settings.d.ts", "default": "./lib/settings.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.js.map", "lib/**/*.d.ts", "lib/**/*.d.ts.map"],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@paimind/ui-foundation": "workspace:^",
    "@paimind/harness-compat": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@paimind/testkit": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "react": "^18.3.1"
  },
  "paimindBuild": {
    "node": ["src/index.ts", "src/settings.ts", "src/invariant.ts"],
    "client": "src/client/index.tsx"
  },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
