{
  "name": "@hansen/agent-builder",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "description": "Headless Hansen business-profile service over native Harness Agent Presets",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/remote.js" },
    "./typert": { "types": "./lib/types/typert.d.ts", "default": "./lib/typert.js" },
    "./client-contract": { "types": "./lib/types/client-contract.d.ts", "default": "./lib/client-contract.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js","lib/**/*.js.map","lib/**/*.d.ts","lib/**/*.d.ts.map","SKILL.md"],
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@hansen/contracts": "workspace:^",
    "@hansen/harness-compat": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hansen/testkit": "workspace:^",
    "@testing-library/react": "^16.3.2"
  },
  "hansenBuild": {
    "node": ["src/index.ts", "src/invariant.ts", "src/remote.ts", "src/typert.ts", "src/client-contract.ts"]
  },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
