{
  "name": "@paimind/agent-builder",
  "version": "0.1.0-alpha.0",
  "description": "Headless PAIMind business-profile service over native Harness Agent Presets",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/remote.js" },
    "./typert": { "types": "./lib/types/typert.d.ts", "default": "./lib/typert.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@paimind/contracts": "workspace:^",
    "@paimind/harness-compat": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@paimind/testkit": "workspace:^",
    "@testing-library/react": "^16.3.2"
  },
  "paimindBuild": {
    "node": ["src/index.ts", "src/invariant.ts", "src/remote.ts", "src/typert.ts"]
  },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
