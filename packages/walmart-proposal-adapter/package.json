{
  "name": "@hansen/walmart-proposal-adapter",
  "version": "0.1.0-alpha.0",
  "description": "Native Harness Tools for synthetic-demo preparation, deterministic Walmart analysis and proposal outlines",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js","lib/**/*.js.map","lib/**/*.d.ts","lib/**/*.d.ts.map","runtime/**/*.py","runtime/**/*.mjs","runtime/**/*.json","runtime/**/*.toml","runtime/**/*.lock","runtime/**/*.yaml","runtime/**/*.sql","runtime/UPSTREAM_COMMIT"],
  "dependencies": {
    "@hansen/artifact-runtime": "workspace:^",
    "@hansen/contracts": "workspace:^",
    "@hansen/harness-compat": "workspace:^",
    "@hansen/presentation-contracts": "workspace:^"
  },
  "devDependencies": { "@hansen/testkit": "workspace:^" },
  "hansenBuild": { "node": ["src/index.ts", "src/invariant.ts"] },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
