{
  "name": "@paimind/generator-web",
  "version": "0.1.0-alpha.0",
  "description": "Native Harness Tool provider for explicit PAIMind HTML artifact generation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "dependencies": {
    "@paimind/artifact-runtime": "workspace:^",
    "@paimind/contracts": "workspace:^",
    "@paimind/harness-compat": "workspace:^"
  },
  "peerDependencies": { "react": ">=18.0.0 <20.0.0" },
  "devDependencies": {
    "@paimind/testkit": "workspace:^",
    "react": "^18.3.1"
  },
  "paimindBuild": {
    "node": ["src/index.ts", "src/invariant.ts"],
    "client": "src/client/index.tsx"
  },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
