{
  "name": "@hansen/testkit",
  "version": "0.1.0-alpha.0",
  "description": "Shared Hansen test helpers for lifecycle and Harness compatibility verification",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "type": "module",
  "main": "lib/index.js",
