{
  "name": "@hansen/platform-scheduler",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "description": "Hansen platform scheduler with durable task definitions, action adapters and run records",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./core": { "types": "./lib/types/core.d.ts", "default": "./lib/core.js" },
    "./time": { "types": "./lib/types/time.d.ts", "default": "./lib/time.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/remote.js" },
    "./typert": { "types": "./lib/types/typert.d.ts", "default": "./lib/typert.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js","lib/**/*.js.map","lib/**/*.d.ts","lib/**/*.d.ts.map"],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@hansen/ui-foundation": "workspace:^",
    "@js-temporal/polyfill": "^0.5.1",
    "@hansen/contracts": "workspace:^",
    "@hansen/harness-compat": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hansen/notifications": "workspace:^",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@hansen/notifications": { "optional": true }
  },
  "devDependencies": {
    "@hansen/notifications": "workspace:^",
    "@hansen/testkit": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "hansenBuild": {
    "node": ["src/index.ts", "src/core.ts", "src/time.ts", "src/invariant.ts", "src/remote.ts", "src/typert.ts"],
    "client": "src/client/index.tsx"
  },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
