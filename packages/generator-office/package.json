{
  "name": "@hansen/generator-office",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "Native Harness Tool providers for PPTX, PDF and formula-bearing XLSX artifacts",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@embedpdf/fonts-sc": "1.0.0",
    "@hansen/artifact-runtime": "workspace:^",
    "@hansen/contracts": "workspace:^",
    "@hansen/harness-compat": "workspace:^",
    "@hansen/presentation-contracts": "workspace:^",
    "exceljs": "4.4.0",
    "pdfkit": "0.20.1",
    "pptxgenjs": "4.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@hansen/presentation-trace": "workspace:^",
    "@hansen/testkit": "workspace:^",
    "@types/pdfkit": "0.17.5",
    "pdf-lib": "1.17.1",
    "react": "^18.3.1"
  },
  "hansenBuild": {
    "node": [
      "src/index.ts",
      "src/cli.ts",
      "src/outline-pptx.ts",
      "src/invariant.ts"
    ],
    "client": "src/client/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false"
  }
}
