# The Webhook URL is a credential. Keep the real value in a secret manager or process environment.
PAIMIND_FEISHU_BOT_WEBHOOKS_JSON={"credential:feishu-bot-rq103":"https://open.feishu.cn/open-apis/bot/v2/hook/<secret>"}

# Must match one keyword configured in the Feishu custom bot.
PAIMIND_FEISHU_BOT_KEYWORD=测试

# Creates one task eight seconds after the isolated research Profile starts.
PAIMIND_FEISHU_BOT_E2E=1
