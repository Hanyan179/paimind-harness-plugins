{
  "name": "@hansen/mcp-center",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "User-owned MCP connection management and native Agent-scoped projections",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./typert": {
      "types": "./lib/types/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@hansen/contracts": "workspace:^",
    "@hansen/harness-compat": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@hansen/testkit": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "hansenBuild": {
    "node": [
      "src/index.ts",
      "src/contract.ts",
      "src/remote.ts",
      "src/typert.ts",
      "src/invariant.ts"
    ],
    "client": "src/client/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false"
  }
}
