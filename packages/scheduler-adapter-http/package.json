{
  "name": "@paimind/scheduler-adapter-http",
  "version": "0.1.0-alpha.0",
  "license": "UNLICENSED",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "description": "Signed HTTPS 202 and asynchronous callback adapter for PAIMind Scheduler",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js","lib/**/*.js.map","lib/**/*.d.ts","lib/**/*.d.ts.map"],
  "dependencies": {
    "@paimind/contracts": "workspace:^",
    "@paimind/harness-compat": "workspace:^",
    "@paimind/platform-sdk": "workspace:^",
    "@paimind/platform-scheduler": "workspace:^"
  },
  "devDependencies": { "@paimind/testkit": "workspace:^" },
  "paimindBuild": { "node": ["src/index.ts", "src/invariant.ts"] },
  "scripts": { "typecheck": "tsc -b --pretty false" }
}
