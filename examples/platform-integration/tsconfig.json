{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../.tmp/types/platform-integration",
    "emitDeclarationOnly": true,
    "composite": true,
    "paths": {
      "@paimind/contracts": ["../../packages/contracts/src/index.ts"],
      "@paimind/harness-compat/host": ["../../packages/harness-compat/src/host.ts"],
      "@paimind/platform-sdk": ["../../packages/platform-sdk/src/index.ts"],
      "@paimind/platform-scheduler": ["../../packages/scheduler/src/index.ts"],
      "@paimind/scheduler-adapter-harness": ["../../packages/scheduler-adapter-harness/src/index.ts"]
    }
  },
  "include": ["index.ts", "harness-plugin.ts"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/harness-compat" },
    { "path": "../../packages/platform-sdk" },
    { "path": "../../packages/scheduler" },
    { "path": "../../packages/scheduler-adapter-harness" }
  ]
}
